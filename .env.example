# Neo4j Configuration
# Copy this file to .env and update the values as needed

# Neo4j authentication (format: username/password).
# Compose sets authentication directly. Update docker-compose.yml and these
# credentials together; Compose does not read NEO4J_AUTH from this file.
NEO4J_AUTH=neo4j/password
NEO4J_URL=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Compose sets heap limits directly in docker-compose.yml.
# Edit those settings for larger graphs; Compose does not read NEO4J_HEAP_SIZE.
NEO4J_HEAP_SIZE=512m

# Compose uses fixed host ports 7475/7688. To change them, edit docker-compose.yml
# and update NEO4J_URL above. Compose does not read the example variables below.
# NEO4J_HTTP_PORT=7475
# NEO4J_BOLT_PORT=7688

# Memgraph Configuration
MEMGRAPH_URL=bolt://localhost:7689
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=

# Default provider selection for examples/ build and search scripts.
# Supported LLM providers: openrouter, azure_openai, openai
# Supported embedder providers: openrouter, azure_openai, openai, sentence-transformer
LLM_PROVIDER=azure_openai
EMBEDDER_PROVIDER=azure_openai

# Example index dimension and SDK factory truncation target.
# Match index dimensions to the actual embedder output; smaller models are not expanded.
EMBEDDING_DIM=1536

# Azure OpenAI provider checks and Neo4j/Memgraph movie smoke tests
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_LLM_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBED_MODEL_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-06-01

# OpenAI provider checks
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
OPENAI_EMBED_MODEL=

# Optional test-factory settings for LLM_PROVIDER=openai only (not SDK env settings).
# Empty/unset omits each option and preserves the model/server defaults.
# Non-thinking models: leave BOTH empty. Revisit overrides when switching models.
# Qwen chat_template_kwargs.enable_thinking: strict lowercase true or false.
LLM_ENABLE_THINKING=
# Standard reasoning_effort: none, minimal, low, medium, high, xhigh.
# Only use levels supported by your endpoint; none is explicit, not unset.
# Independent of the Qwen toggle; no automatic mapping between these options.
LLM_REASONING_EFFORT=

# OpenRouter provider checks
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=
OPENROUTER_EMBED_MODEL=

# Anthropic provider (also supports OpenRouter Anthropic-compatible endpoint)
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-sonnet-4-20250514
# To use DeepSeek via OpenRouter's Anthropic endpoint:
# ANTHROPIC_API_KEY=<your-openrouter-key>
# ANTHROPIC_LLM_MODEL=deepseek/deepseek-v4-pro
# ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Sentence-Transformers (local, no API key)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Optional test run flags
# Set these to 1/true/yes only when you intentionally want external services.
RUN_PROVIDER_INTEGRATION_TESTS=
RUN_DATABASE_INTEGRATION_TESTS=
RUN_WORKFLOW_INTEGRATION_TESTS=
RUN_E2E_INTEGRATION_TESTS=
RUN_ENTITY_RESOLUTION_AI_TESTS=
